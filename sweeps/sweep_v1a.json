{
  "name": "v1a-hybrid-tau1-tau2",
  "runs": [
    {
      "name": "s1_hybrid_tau1_e2",
      "args": {
        "backbone": "jhu-clsp/ettin-encoder-32m",
        "pooling": "cls",
        "loss": "hybrid",
        "tau": 1.0,
        "mse-weight": 0.005,
        "margin-weight": 0.005,
        "docs-per-query": 10,
        "exclude-sources": ["kalm:openorca", "kalm:esci"],
        "max-length": 512,
        "batch-size": 24,
        "grad-accum": 2,
        "lr": 1.2e-4,
        "weight-decay": 0.01,
        "epochs": 2.0,
        "code-upsample": 1,
        "long-doc-upsample": 2,
        "log-every": 250
      }
    },
    {
      "name": "s2_hybrid_tau1_4k",
      "args": {
        "backbone": "/workspace/ckpts/s1_hybrid_tau1_e2",
        "pooling": "cls",
        "loss": "hybrid",
        "tau": 1.0,
        "mse-weight": 0.005,
        "margin-weight": 0.005,
        "docs-per-query": 8,
        "exclude-sources": ["kalm:openorca", "kalm:esci"],
        "max-length": 4096,
        "batch-size": 4,
        "grad-accum": 8,
        "lr": 3e-5,
        "weight-decay": 0.01,
        "max-steps": 1800,
        "long-doc-upsample": 10,
        "code-upsample": 2,
        "grad-checkpointing": true,
        "log-every": 150
      }
    },
    {
      "name": "s1_hybrid_tau2_e2",
      "args": {
        "backbone": "jhu-clsp/ettin-encoder-32m",
        "pooling": "cls",
